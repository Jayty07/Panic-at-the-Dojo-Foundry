      {
        "id": "barbrawl",
        "type": "module",
        "reason": "Multiple resource bars (HP, Health Bars, Shield) above each token."
      },
      {
        "id": "isometric-perspective",
        "type": "module",
        "reason": "Isometric scenes. The system lifts token bars above the sprite's head."
      },
